/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://wa.me; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/eyewear/*
  Cache-Control: public, max-age=31536000, immutable
/mediapipe/*
  Cache-Control: public, max-age=31536000, immutable
